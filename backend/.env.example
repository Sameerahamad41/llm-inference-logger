DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_URL_SYNC=sqlite:///./dev.db

# At least one provider API key is required
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default provider and model
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# Database (set automatically by docker-compose)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/inference_logger
# DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/inference_logger

# PII redaction
PII_REDACTION_ENABLED=true
